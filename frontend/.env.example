# TrustVault Frontend Environment Configuration

# Local Development (using Vite dev proxy in vite.config.ts):
# Leave blank to route /auth, /documents, /admin, and /users to http://127.0.0.1:8000 via proxy:
VITE_API_BASE_URL=

# Connecting directly to a local backend without proxy:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Production Render Deployment:
# Point to the live TrustVault backend on Render:
# VITE_API_BASE_URL=https://trustvault-back.onrender.com

# Local demo credentials (development/hackathon evaluation only - NEVER use in production)
VITE_DEMO_PASSWORD=123456789abc
