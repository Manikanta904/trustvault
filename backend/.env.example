# TrustVault Backend Environment Configuration Template
# Copy this file to backend/.env and provide your actual local or deployment values.
# NEVER commit real credentials, database passwords, or JWT secrets to version control.

# Primary PostgreSQL Application Database Connection String
DATABASE_URL=postgresql+psycopg://trustvault_app:your_secure_password@localhost:5432/trustvault

# Dedicated PostgreSQL Test Database Connection String (used by pytest)
DATABASE_URL_TEST=postgresql+psycopg://trustvault_app:your_secure_password@localhost:5432/trustvault_test

# JWT Secret Key (HMAC-SHA256, minimum 32 high-entropy characters required)
JWT_SECRET=replace_with_a_random_32_character_or_longer_secret_key_here

# JWT Expiration Lifetime in Minutes (default: 30)
JWT_EXPIRE_MINUTES=30

# Optional Private File Storage Directory Override
# Defaults to backend/private_storage if left unspecified
# TRUSTVAULT_STORAGE_DIR=/absolute/path/to/private_storage

# Allowed CORS Origins (comma-separated list for additional web client origins)
# Production Frontend: https://trustvault-ui-obkw.onrender.com
# Local Dev: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=https://trustvault-ui-obkw.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Local Demonstration Account Credentials (used only by seed_demo.py)
# NEVER use default credentials in staging or production environments.
# DEMO_DEFAULT_PASSWORD=123456789abc
# DEMO_PASSWORD_ADMIN=
# DEMO_PASSWORD_OWNER=
# DEMO_PASSWORD_VIEWER=
